{
  "name": "cindr",
  "version": "0.1.0",
  "description": "cindr: CashTokens burn-to-mint May 2026 Layla-loop covenant and 0-conf trophy protocol on Bitcoin Cash",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "server": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "tsx src/server.ts",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "build": "node scripts/sync-vendor.mjs && tsc",
    "lint:js": "node --check public/app.js && node --check public/dashboard.js && node --check scripts/sync-vendor.mjs && node --check scripts/plain-words-check.mjs",
    "verify": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "check:words": "node scripts/plain-words-check.mjs",
    "evidence": "tsx scripts/generate-evidence.ts",
    "sync:tokenhunt": "tsx scripts/sync-tokenhunt.ts",
    "deploy:chipnet": "tsx scripts/deploy-chipnet.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.0.0",
    "@wizardconnect/dapp": "^0.2.8",
    "cashc": "^0.14.0",
    "cashscript": "^0.14.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
