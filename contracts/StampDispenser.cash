pragma cashscript ^0.14.0;

// StampDispenser: 0-Conf Demo Stamp Faucet Covenant
//
// Lets any judge with an empty wallet mint 5 distinct Demo Stamp NFTs (commitments 0x01..0x05)
// in one 0-conf transaction so they can immediately test BlazeForge on BCH Mainnet or Chipnet.
contract StampDispenser(bytes32 demoCategory) {
    function claim5(bytes recipientLockingBytecode) {
        // Preserve the Dispenser Minting Baton NFT at Output 0 for instant 0-conf chaining
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].tokenCategory == demoCategory + 0x02);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == demoCategory + 0x02);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].value >= 1000);
        require(tx.outputs[0].value >= tx.inputs[0].value);

        // Mint 5 distinct immutable Demo Stamp NFTs (commitments 0x01..0x05) via Layla loop
        int i = 1;
        do {
            require(tx.outputs[i].lockingBytecode == recipientLockingBytecode);
            require(tx.outputs[i].tokenCategory == demoCategory);
            require(tx.outputs[i].tokenAmount == 0);
            require(tx.outputs[i].nftCommitment == toPaddedBytes(i, 1));
            require(tx.outputs[i].value >= 1000);
            i = i + 1;
        } while (i <= 5);

        require(i == 6);

        // Allow optional pure-BCH fee change at Output 6 with zero extra tokens
        require(tx.outputs.length <= 7);
        if (tx.outputs.length == 7) {
            require(tx.outputs[6].tokenCategory == 0x);
        }
    }
}
