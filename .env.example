# Server HTTP port (0 lets the OS assign an ephemeral port in tests)
PORT=3000

# Network provider: "mock" (local deterministic CashVM), "chipnet", or "mainnet"
BCH_NETWORK=mock

# Allowed browser origin for CORS responses (e.g. https://blaze.example.com)
ALLOWED_ORIGIN=*

# Required when BCH_NETWORK is "chipnet" or "mainnet" (never use a dummy key on live nets)
# FAUCET_PRIVKEY_HEX=

# Optional 64-char CashTokens category IDs for custom Forge / Demo Dispenser deployments
# FORGE_CATEGORY=
# DEMO_CATEGORY=

# Optional JSON map overriding staging TokenHunt badge categories when activated on bchblaze.cash
# TOKENHUNT_OVERRIDES_JSON={"showcase-showoff":"..."}

# Per-IP POST rate limit (requests per 60-second window)
RATE_LIMIT_MAX_PER_MIN=120

# Set "true" only for local automated scripts that supply signerPrivKeyHex over HTTP
ALLOW_UNSAFE_LOCAL_SIGNING=false
